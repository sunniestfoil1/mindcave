{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": { "maxFileSize": 1048576 },
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": false,
    "compress": false,
    "removeComments": true,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "fileSummary": true,
    "directoryStructure": true,
    "topFilesLength": 10,
    "git": { "sortByChanges": false, "includeDiffs": false, "includeLogs": false }
  },
  "include": [
    "package.json",
    "index.html",
    "vite.config.js",
    "tailwind.config.js",
    "src/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/*.md",
      "scripts/**",
      "lab/**",
      "data/**",
      "public/**",
      "dist/**",
      "referencias-render/**",
      "ceu_extracted/**",
      ".agents/**",
      ".claude/**",
      ".vercel/**",
      "docs/**",
      "mind-cave-prd/**",
      "supabase/**",
      "src/game/mcgen/**",
      "src/components/studio/**",
      "src/components/game/AssetsVoxelBrowser.jsx",
      "src/components/game/ItemRigBrowser.jsx",
      "src/components/game/MatchlockViewer.jsx",
      "src/components/game/ModelScene.jsx",
      "src/components/options/SettingsPage.jsx",
      "src/components/ProtectedRoute.jsx",
      "src/components/ui/accordion.jsx",
      "src/components/ui/alert-dialog.jsx",
      "src/components/ui/alert.jsx",
      "src/components/ui/aspect-ratio.jsx",
      "src/components/ui/avatar.jsx",
      "src/components/ui/badge.jsx",
      "src/components/ui/breadcrumb.jsx",
      "src/components/ui/calendar.jsx",
      "src/components/ui/card.jsx",
      "src/components/ui/carousel.jsx",
      "src/components/ui/chart.jsx",
      "src/components/ui/checkbox.jsx",
      "src/components/ui/collapsible.jsx",
      "src/components/ui/command.jsx",
      "src/components/ui/context-menu.jsx",
      "src/components/ui/drawer.jsx",
      "src/components/ui/dropdown-menu.jsx",
      "src/components/ui/form.jsx",
      "src/components/ui/hover-card.jsx",
      "src/components/ui/image-helpers.js",
      "src/components/ui/image.jsx",
      "src/components/ui/menubar.jsx",
      "src/components/ui/navigation-menu.jsx",
      "src/components/ui/pagination.jsx",
      "src/components/ui/popover.jsx",
      "src/components/ui/progress.jsx",
      "src/components/ui/radio-group.jsx",
      "src/components/ui/resizable.jsx",
      "src/components/ui/responsive-image.jsx",
      "src/components/ui/scroll-area.jsx",
      "src/components/ui/select.jsx",
      "src/components/ui/separator.jsx",
      "src/components/ui/sheet.jsx",
      "src/components/ui/sidebar.jsx",
      "src/components/ui/skeleton.jsx",
      "src/components/ui/slider.jsx",
      "src/components/ui/sonner.jsx",
      "src/components/ui/switch.jsx",
      "src/components/ui/table.jsx",
      "src/components/ui/tabs.jsx",
      "src/components/ui/textarea.jsx",
      "src/components/ui/toast.jsx",
      "src/components/ui/toggle-group.jsx",
      "src/components/ui/toggle.jsx",
      "src/components/ui/tooltip.jsx",
      "src/components/ui/use-responsive-image.jsx",
      "src/game/guns/models.js",
      "src/hooks/use-mobile.jsx",
      "src/hooks/use-size.jsx",
      "src/pages/Home.jsx",
      "src/pages/OAuthConsent.jsx",
      "src/utils/index.ts",
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**",
      "**/*.tmp.*",
      "**/tmp/**",
      "**/temp/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.svg",
      "**/*.ico",
      "**/*.ogg",
      "**/*.mp3",
      "**/*.wav",
      "**/*.ttf",
      "**/*.otf",
      "**/*.woff",
      "**/*.woff2",
      "**/*.glb",
      "**/*.zip",
      "**/*.gz",
      "**/*.log",
      "**/.env*",
      "package-lock.json",
      "skills-lock.json",
      "src/game/recipesReal.json",
      "repomix-output.*",
      "repomix-docs-output.*"
    ]
  },
  "security": { "enableSecurityCheck": true },
  "tokenCount": { "encoding": "o200k_base" }
}
