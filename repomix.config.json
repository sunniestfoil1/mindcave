{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": { "maxFileSize": 1048576 },
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": false,
    "compress": false,
    "removeComments": true,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "fileSummary": true,
    "directoryStructure": true,
    "topFilesLength": 10,
    "git": { "sortByChanges": false, "includeDiffs": false, "includeLogs": false }
  },
  "include": [
    "package.json",
    "index.html",
    "vite.config.js",
    "tailwind.config.js",
    "src/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/*.md",
      "scripts/**",
      "lab/**",
      "data/**",
      "public/**",
      "dist/**",
      "referencias-render/**",
      "ceu_extracted/**",
      ".agents/**",
      ".claude/**",
      ".vercel/**",
      "docs/**",
      "mind-cave-prd/**",
      "supabase/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**",
      "**/*.tmp.*",
      "**/tmp/**",
      "**/temp/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.svg",
      "**/*.ico",
      "**/*.ogg",
      "**/*.mp3",
      "**/*.wav",
      "**/*.ttf",
      "**/*.otf",
      "**/*.woff",
      "**/*.woff2",
      "**/*.glb",
      "**/*.zip",
      "**/*.gz",
      "**/*.log",
      "**/.env*",
      "package-lock.json",
      "skills-lock.json",
      "src/game/recipesReal.json",
      "repomix*"
    ]
  },
  "security": { "enableSecurityCheck": true },
  "tokenCount": { "encoding": "o200k_base" }
}
